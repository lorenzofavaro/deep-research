# Google AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_api_key_here

# Web search
TAVILY_API_KEY=your_tavily_api_key_here

# Citation counts and most cited papers (optional: without a key OpenAlex uses a small shared daily budget)
# OPENALEX_API_KEY=your_openalex_api_key_here

# Models (optional): MODEL for classification, planning, reflection and the answer,
# FAST_MODEL for the researchers, which make most of the calls.
# Comma-separated chains fall back to the next model on quota, rate-limit or server errors.
MODEL=gemini-flash-latest,gemini-flash-lite-latest
FAST_MODEL=gemini-flash-lite-latest,gemini-flash-latest

# Research limits (optional)
# MAX_STEPS=3                 researchers per round
# MAX_ITERATIONS=2            research rounds
# RESEARCHER_TOOL_CALLS=10    search/read calls per researcher (5 for simple questions)
# PASSAGES_PER_READ=6
# ARXIV_CANDIDATES=30
# CITED_CANDIDATES=15
# PAPER_MAX_CHARS=100000
# WEB_RESULTS=5
# PAGE_MAX_CHARS=20000

# Logging Configuration
LOG_LEVEL=INFO
